##### Default values
option add *ComboBox*font {Courier 12}

set glob(numpages) 5
set glob(curpage) 1
set glob(res200dpi) 0 ;# 0 = 300dpi , 1 = 200dpi
set glob(model,0) "Pentax PocketJet II"
set glob(model,1) "Pentax PocketJet 200"
set glob(generic) "Pentax PocketJet II/200"
set glob(driverpath) /usr/local/pentaxpj
#set glob(title) "$glob(model,$glob(res200dpi)) Installation"
set glob(title) "Pentax PocketJet II/200 Installation"
set glob(kde) 1

set kde_template {# KDE Config File
[KDE Desktop Entry]
Name[fi]=Sovellus
Name[hr]=Program
Name[sl]=Uporabni¹ki program
Name[pl]=Aplikacja
Name=PocketJet config tool
Name[ca]=Aplicacions
