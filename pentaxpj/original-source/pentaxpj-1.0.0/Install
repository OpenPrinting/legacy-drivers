#!/bin/sh
# The next line is executed by /bin/sh, but not tcl \
exec wish "$0" ${1+"$@"}

set dir BWidget-1.3.1

if {"[exec whoami]" != "root"} {
	tk_messageBox -type ok -message "You must be root to install \
this software. Please do \"sudo Install\" instead!"
	exit 1
}

