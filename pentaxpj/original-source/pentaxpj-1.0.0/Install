Comment[pt_BR]=
Exec=$glob(driverpath)/pentaxsetup
Type=Application
MimeType=
SwallowExec=
SwallowTitle=
BinaryPattern=
}

##### Procedures
proc createshortcuts {} {
	global glob kde_template
	set error 0
	if {$glob(kde)} {
		if {![file isdirectory ~/Desktop]} {
			set error 1
		} else {
			set f [open ~/Desktop/pentaxpj w]
			puts $f [subst -nocommand $kde_template]
			close $f
		}
		if {$error} {
			tk_dialog .msgbox "Shortcut creation error." \
				"Could not create KDE shortcut.
Execute $glob(generic) with this command:
$glob(driverpath)/pentaxsetup" error 0 OK
			return 0
		}
	}
	return 1
	
}

proc savesettings {} {
	global glob 
	set cmdline #
	set config "set settings(driverpath) $glob(driverpath)"
	set fd [open /etc/pentaxpj.conf w]
	puts $fd $cmdline
	puts $fd $config
	close $fd
	return 1
}

proc copyfiles {} {
	global glob
	foreach f {pentaxsetup pentaxpj test-page.ps.gz 
			pentax.xpm BWidget-1.3.1} {
		if {[catch {file copy -force $f $glob(driverpath)}]} {
			return $f  
		}
	}
	exec ln -sf $glob(driverpath)/pentaxsetup /usr/bin
	exec ln -sf $glob(driverpath)/pentaxpj $glob(driverpath)/pentaxpj_sh
	return ""
}

proc createdir {} {
	global glob
	if {![file exists $glob(driverpath)]} {
		if {[catch {file mkdir $glob(driverpath)}]} {
			return 0
		}
	} else {
		if {[catch {file delete -force $glob(driverpath)}]} {
			return 0
		}
		if {[catch {file mkdir $glob(driverpath)}]} {
			return 0
		}
	}
	return 1
}

proc install {} {
	global glob
	if {![createdir]} {
		tk_dialog .msgbox "Directory creation error." \
		"Could not create directory $glob(driverpath).
Please try installing to another path." error 0 OK
		set glob(curpage) 2
		raise .f2
		return 0
	}
	set ftrouble [copyfiles]
	if {$ftrouble != ""} {
		tk_dialog .msgbox "File copying error." \
		"Could not copy file $ftrouble to the directory $glob(driverpath).
Please verify if it exists and you have write permissions to $glob(driverpath).
" error 0 OK
		set glob(curpage) 2
		raise .f2
		return 0
	}
	if {![savesettings]} {
		tk_dialog .msgbox "File creation error." \
		"Could not create the configuration file in directory $glob(driverpath).
Please verify if you have write permissions to this path." error 0 OK
		set glob(curpage) 2
		raise .f2
		return 0
	}
	createshortcuts
	return 1
}

proc cancel {} {
	global glob
	if {![tk_dialog .msgbox "Installation not complete." "Are you sure you want to exit $glob(title)?" question 1 "Yes" "No"]} {
		exit
	}
}

proc next {} {
	global glob
	switch $glob(curpage) {
		1 {
			incr glob(curpage)
			raise .f$glob(curpage)
			.prev configure -state normal
		}
		2 {
			incr glob(curpage)
			raise .f$glob(curpage)
		}
		3 {
			incr glob(curpage)
			raise .f$glob(curpage)
			.next configure -text Finish
		}
		4 {
			if {[install]} {
				incr glob(curpage)
				raise .f$glob(curpage)
				.next configure -text Exit
				.prev configure -state disabled
				.cancel configure -state disabled
			}
		}
		5 {
			exit
		}
		default {
			incr glob(curpage)
			raise .f$glob(curpage)
		}
	}
}

proc prev {} {
	global glob
	incr glob(curpage) -1
	switch $glob(curpage) {
		1 {
			.prev configure -state disabled
			raise .f$glob(curpage)
		}
		3 {
			.next configure -text "Next >>"
			raise .f$glob(curpage)
		}
		default {
			raise .f$glob(curpage)
		}
	}
}

####### GUI
place [label .logo -image logo] -x 10 -y 10
place [Separator .sep -orient horizontal] -x 10 -y 280 -width 492
place [button .cancel -text Cancel -command cancel] \
	-width 80 -height 30 -anchor se -x 502 -y 324
place [button .next -text "Next >>" -command next] \
	-width 80 -height 30 -anchor se -x 412 -y 324
place [button .prev -text "<< Previous" -command prev -state disabled] \
	-width 80 -height 30 -anchor se -x 322 -y 324
for {set i $glob(numpages)} {$i > 0} {incr i -1} {
	place [frame .f$i] \
		-anchor ne -x 502 -y 10 -width 360 -height 260
}

###Page 1
pack [label .f1.l1 -justify left -wraplength 360 \
		-text "Welcome to $glob(title).\n\n
This program will install $glob(generic) drivers on your computer."]	\
	-anchor nw
pack [label .f1.l2 -text "Click \"Next >>\" to continue."] \
	-anchor sw -side bottom

###Page 2
pack [label .f2.l1 -justify left -wraplength 360 \
		-text "The software will be installed in the following location:\n"] \
	[entry .f2.e1 -textvariable glob(driverpath) -bg white -width 70] \
	[label .f2.l2 -justify left -wraplength 360 \
		-text "\n\nIf you want to change the location, type a new one in the text box. If the directory doesn't exist, it will be created."] \
	-ancho nw
pack [label .f2.l3 \
	-text "When you are satisfied with the location, click \"Next >>\""] \
	-anchor sw -side bottom 

###Page 3
pack [label .f3.l1 -justify left -wraplength 360 \
		-text "$glob(title) can create the following shortcuts. Uncheck the box associated with any shortcut you don't want to be created.\n\n"] \
	[checkbutton .f3.cb1 -text "Create KDE shortcut" -variable glob(kde)] \
	-anchor nw
pack [label .f3.l2 -text "Click \"Next >>\" to continue."] \
	-anchor sw -side bottom

###Page 4
pack [label .f4.l1 -justify left -wraplength 360 \
		-text "$glob(title) has finished gathering all information neccessary to begin installation."] \
	-anchor nw
pack [label .f4.l2 \
		-text "Click \"Finish\" to conclude the installation process."] \
	-anchor sw -side bottom

###Page 5
pack [label .f5.l1 -justify left -wraplength 360 \
		-text "$glob(generic) drivers was successfully installed on you computer. \n\n"] -anchor nw
pack [label .f5.l2 -text "Click \"Exit\" to exit $glob(title)."] \
	-anchor sw -side bottom

raise .f1
update
wm resizable . 0 0
wm title . $glob(title)
wm geom . =512x334+[expr [winfo vrootwidth .]/2 - [winfo width .]/2]+[expr \
	[winfo vrootheight .]/2 - [winfo height .]/2]

if {![file exists pentaxpj]} {
	tk_messageBox -type ok -message "You must run \"make\" before \
installing PocketJet driver. When the software is made, please come back to
install it again. Thanks."
	exit 1
}

